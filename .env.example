# SDK mode: Hugging Face first, OpenAI as backup (set one or both)
HUGGINGFACEHUB_API_TOKEN=your_hf_token
OPENAI_API_KEY=your_openai_key
# QA_TUTOR_MODEL=deepseek-ai/DeepSeek-R1-0528     # HF primary (repo id)
# QA_TUTOR_FALLBACK_MODEL=openai/gpt-4o-mini      # OpenAI backup

